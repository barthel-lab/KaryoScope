# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C/C++ build artifacts
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# Build / distribution
build/
dist/
*.egg-info/
*.egg
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Linters
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Sphinx / docs build
docs/_build/
docs/site/

# Local config / secrets
.env
.envrc
*.local.yaml

# Bioinformatics: large / generated data files that should never be committed
*.fasta
*.fa
*.fna
*.fastq
*.fq
*.fasta.gz
*.fa.gz
*.fna.gz
*.fastq.gz
*.fq.gz
*.bam
*.bam.bai
*.cram
*.cram.crai
*.sam
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bed
*.bed.gz
*.bed.gz.tbi
*.kmc_pre
*.kmc_suf
*.fai
*.gzi
*.tbi
*.csi

# Exception: the tiny demo FASTA is intentionally committed (see examples/).
!examples/demo.fa

# But: keep tiny test fixtures committed (override the above)
!tests/data/**

# The unpacked dummy db is regenerated from tests/data/dummy_db.tar.gz at
# test-suite startup. Only the tarball + its SHA-256 are committed.
tests/data/dummy_db/

# Re-ignore Python bytecode cache under tests/data (the `!tests/data/**`
# negation above otherwise re-includes it).
tests/data/__pycache__/

# Local results and scratch
results/
scratch/
tmp/
work/

# Snakemake / Nextflow
.snakemake/
.nextflow*
work/

# C++ generated
native/*/build/
native/*/bin/

# Operating system
Thumbs.db
